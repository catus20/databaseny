<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="admin.css">
    <script src="script.js"></script>
    <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>
    <title>Admin - EmreBoxd</title>
</head>

<body>
    <header id="admin-header">
        <nav id="admin-nav">
            <ul class="nav">
                <ul>
                    <a href="/home">
                        <i class="fas fa-home"></i> Heim
                    </a>
                </ul>
                <ul>
                    <a href="/profile">
                        <i class="fas fa-user"></i> Min profil
                    </a>
                </ul>
                <% if (admin) { %>
                <ul>
                    <a href="/admin" class="active">
                        <i class="fas fa-cogs"></i> Admin
                    </a>
                </ul>
                <% } %>
                <ul>
                    <a href="/logout">
                        <i class="fas fa-sign-out-alt"></i> Logg ut
                    </a>
                </ul>
            </ul>
        </nav>
    </header>

    <main id="admin-main">
        <div id="admin-container" class="container">
            <h2>Admin Panel</h2>
            <h3>Brukarar</h3>
            <div id="admin-table-container" class="table-container">
                <table id="admin-table">
                    <thead>
                        <tr>
                            <th>Fornamn</th>
                            <th>Etternamn</th>
                            <th>Email</th>
                            <th>Handlinger</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach((user) => { %>
                            <tr>
                                <td data-label="Fornavn"><%= user.firstname %></td>
                                <td data-label="Etternavn"><%= user.lastname %></td>
                                <td data-label="Email"><%= user.email %></td>
                                <td class="actions">
                                    <a href="/admin/edit-user/<%= user.id %>" class="editTable-btn">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form action="/admin/delete/<%= user.id %>" method="post"
                                          onsubmit="return confirm('Er du sikker på at du vil slette denne brukeren?');">
                                        <button type="submit" class="delete-btn">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>
