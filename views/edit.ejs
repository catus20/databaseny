<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rediger Profil - EmreBoxd</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/profile.css">
    <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>
</head>

<body>
    <header>
        <nav>
            <ul class="nav">
                <ul><a href="/home"><i class="fas fa-home"></i> Heim</a></ul>
                <ul><a href="/profile" class="active"><i class="fas fa-user"></i> Min profil</a></ul>
                <% if (admin) { %>
                <ul><a href="/admin"><i class="fas fa-cogs"></i> Admin</a></ul>
                <% } %>
                <ul><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logg ut</a></ul>
            </ul>
        </nav>
        
    </header>
    
    <main>
        <div class="container">
            <div class="form-box">
                <h1>Rediger Profil</h1>
                <form action="/profile/edit/<%= user.id %>" method="post">

                    <div class="input-container">
                        <label>Fornamn:</label>
                        <input type="text" name="firstname" placeholder="Fornavn" value="<%= user.firstname %>"
                            required>
                    </div>

                    <div class="input-container">
                        <label>Etternamn:</label>
                        <input type="text" name="lastname" placeholder="Etternavn" value="<%= user.lastname %>"
                            required>
                    </div>

                    <div class="input-container">
                        <label>Epost:</label>
                        <input type="email" name="email" placeholder="E-post" value="<%= user.email %>" readonly>
                    </div>
                    

                    <button type="submit" class="save-btn">Lagre endringar</button>
                    <button type="button" class="cancel-btn" onclick="window.history.back()">Avbryt</button>
                </form>
            </div>
        </div>
    </main>
</body>

</html>