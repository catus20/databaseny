<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rediger Bruker</title>
    <link rel="stylesheet" href="/edit.css">
    <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>
</head>

<body>
    <header id="admin-header">
        <nav id="admin-nav">
            <ul class="nav">
                <ul>
                    <a href="/home">
                        <i class="fas fa-home"></i> Heim
                    </a>
                </ul>
                <ul>
                    <a href="/profile">
                        <i class="fas fa-user"></i> Min profil
                    </a>
                </ul>
                <% if (admin) { %>
                <ul>
                    <a href="/admin" class="active">
                        <i class="fas fa-cogs"></i> Admin
                    </a>
                </ul>
                <% } %>
                <ul>
                    <a href="/logout">
                        <i class="fas fa-sign-out-alt"></i> Logg ut
                    </a>
                </ul>
            </ul>
        </nav>
    </header>
    <h2>Rediger Bruker</h2>
    <form action="/admin/edit-user/<%= user.id %>" method="POST">
        <label for="firstname">Fornavn:</label>
        <input type="text" id="firstname" name="firstname" value="<%= user.firstname %>" required><br>

        <label for="lastname">Etternavn:</label>
        <input type="text" id="lastname" name="lastname" value="<%= user.lastname %>" required><br>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= user.email %>" required><br>

        <!-- Rolle dropdown -->
        <div>
            <label for="role">Rolle:</label>
            <select id="role" name="role">
                <option value="0" <%= user.role === 0 ? 'selected' : '' %>>Bruker</option>
                <option value="1" <%= user.role === 1 ? 'selected' : '' %>>Admin</option>
            </select>
        </div>

        <button type="submit">Oppdater</button>
    </form>
</body>

</html>
