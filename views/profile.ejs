<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Min profil - OSS AS</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/profile.css">
    <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">


</head>

<body>
    <header>
        <nav>
            <ul class="nav">
                <ul>
                    <a href="/home">
                        <i class="fas fa-home"></i> Heim
                    </a>
                </ul>
                <ul>
                    <a href="/profile" class="active">
                        <i class="fas fa-user"></i> Min profil
                    </a>
                </ul>
                <% if (admin) { %>
                <ul>
                    <a href="/admin">
                        <i class="fas fa-cogs"></i> Admin
                    </a>
                </ul>
                <% } %>
                <ul>
                    <a href="/logout">
                        <i class="fas fa-sign-out-alt"></i> Logg ut
                    </a>
                </ul>
            </ul>
        </nav>
        
      </header>
      

      <main>
        <div class="container" id="containerprofile">
            <!-- Profilseksjon -->
            <div class="profile-container">
                <h2>Min Profil</h2>
                <h3>Profilinformasjon</h3>
                <p><strong>Fornavn:</strong> <%= user.firstname %></p>
                <p><strong>Etternavn:</strong> <%= user.lastname %></p>
                <p><strong>E-post:</strong> <%= user.email %></p>
            </div>
            <a href="/profile/edit" class="btn">Endre profil</a> <!-- Legger til klasse for knappstil -->
        </div>
    </main>
    
    
    
</body>

</html>
