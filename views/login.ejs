<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,minimum-scale=1">
    <title>Login</title>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.1/css/all.css">
    <link href="style.css" rel="stylesheet" type="text/css">
    <style>
        /* === Globale variabler og basisstil === */
        :root {
            --text-color: #f0f0f0;
            --accent-color: #00ff88;
            --background-color: #0d1a17;
            --input-bg: rgba(255, 255, 255, 0.05);
            --input-border: rgba(0, 255, 136, 0.2);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--background-color);
            color: var(--text-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
        }

        /* === Navigasjon === */
        header {
            width: 100%;
            background-color: rgba(0, 255, 136, 0.05);
            border-bottom: 1px solid rgba(0, 255, 136, 0.2);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navlinks {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: center;
            gap: 2rem;
            list-style-type: none;
        }

        .navlinks li {
            display: inline-block;
        }

        .navlinks a {
            font-weight: bold;
            font-size: 1rem;
            color: var(--text-color);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .navlinks a.active {
            background-color: rgba(0, 255, 136, 0.1);
            color: var(--accent-color);
        }

        .navlinks a:hover {
            background-color: rgba(0, 255, 136, 0.1);
            color: var(--accent-color);
        }

        /* === Form styling === */
        .form-wrapper {
            position: relative;
            width: 100%;
            height: 100vh; /* Full høgde */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .form-box {
            position: absolute;
            width: 300px; /* Juster breidde som du vil */
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease;
        }

        .form-box.active {
            opacity: 1;
            pointer-events: auto;
        }

    </style>
</head>
<body>
    <header>
        <nav aria-label="Hovedmeny">
            <ul class="navlinks">
                <li><i class="fas fa-home"></i><a href="/">Heim</a></li>
                <li><i class="fas fa-lock"></i><a href="/login" class="active">Logg inn</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <div class="form-wrapper">
            <!-- Login form -->
            <div id="login-form" class="form-box active">
                <h1>Logg inn</h1>
                <form action="/auth" method="post">
                    <label for="email"><i class="fas fa-user"></i></label>
                    <input type="text" name="email" placeholder="E-post" id="email" required>
                    
                    <label for="password"><i class="fas fa-lock"></i></label>
                    <input type="password" name="password" placeholder="Passord" id="password" required>
                    
                    <input type="submit" value="Logg inn">
                </form>
                <p>Har du ikkje ein brukar? <a href="#" onclick="toggleForm()">Registrer deg her</a></p>
            </div>

            <!-- Register form -->
            <div id="register-form" class="form-box">
                <h1>Registrer deg</h1>
                <form action="/register" method="post">
                    <label for="first-name"><i class="fas fa-user"></i></label>
                    <input type="text" name="fname" placeholder="Fornamn" id="fname" required>

                    <label for="last-name"><i class="fas fa-user"></i></label>
                    <input type="text" name="lname" placeholder="Etternamn" id="lname" required>

                    <label for="new-email"><i class="fas fa-envelope"></i></label>
                    <input type="text" name="email" placeholder="E-post" id="email" required>

                    <label for="new-password"><i class="fas fa-lock"></i></label>
                    <input type="password" name="password" placeholder="Passord" id="password" required>

                    <label for="confirm-password"><i class="fas fa-lock"></i></label>
                    <input type="password" name="confirmPassword" placeholder="Bekreft passord" id="confirmPassword" required>

                    <input type="submit" value="Registrer deg">
                </form>
                <p>Har du allereie ein brukar? <a href="#" onclick="toggleForm()">Logg inn her</a></p>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
    <script>
        function toggleForm() {
          const loginForm = document.getElementById('login-form');
          const registerForm = document.getElementById('register-form');
      
          if (loginForm.classList.contains('active')) {
            loginForm.classList.remove('active');
            registerForm.classList.add('active');
          } else {
            registerForm.classList.remove('active');
            loginForm.classList.add('active');
          }
        }
      
        // Sett login aktiv frå start
        document.getElementById('login-form').classList.add('active');
    </script>
</body>
</html>
