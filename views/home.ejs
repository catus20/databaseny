<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="style.css">
  <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>

  <title>Heim</title>
</head>

<body>
  <header>
    <nav>
      <ul class="nav">
        <li>
          <a href="/home" class="active">
            <i class="fas fa-home"></i> Heim
          </a>
        </li>
        <li>
          <a href="/profile">
            <i class="fas fa-user"></i> Min profil
          </a>
        </li>
        <% if (admin) { %>
          <li>
            <a href="/admin"> <i class="fas fa-cogs"></i> Admin </a>
          </li>
        <% } %>
        <li>
          <a href="/logout">
            <i class="fas fa-sign-out-alt"></i> Logg ut
          </a>
        </li>
      </ul>
    </nav>
  </header>
  
  <div class="page-container">
    <h1 class="page-title">IMDb Top 10 Movies</h1>
    
    <div class="form-box">
      <h2>Legg til en ny film</h2>
      <form action="/add-movie" method="POST">
        <div>
          <i class="fas fa-film"></i>
          <input type="text" id="tittel" name="tittel" placeholder="Tittel" required>
        </div>
        
        <div>
          <i class="fas fa-calendar-alt"></i>
          <input type="number" id="årstall" name="årstall" placeholder="Årstall" min="1900" max="2030" required>
        </div>
        
        <div>
          <i class="fas fa-user-tie"></i>
          <input type="text" id="regissør" name="regissør" placeholder="Regissør" required>
        </div>
        
        <div>
          <i class="fas fa-star"></i>
          <input type="number" id="rating" name="rating" placeholder="IMDb Rating" min="0" max="10" step="0.1" required>
        </div>
        
        <div>
          <i class="fas fa-tag"></i>
          <input type="text" id="sjanger" name="sjanger" placeholder="Sjanger" required>
        </div>
        
        <div>
          <i class="fas fa-image"></i>
          <input type="url" id="image_url" name="image_url" placeholder="Bilde URL" required>
        </div>
        
        <input type="submit" value="Legg til film">
      </form>
    </div>
    
    <div class="movies-container">
      <% movies.forEach(movie => { %>
        <div class="movie-card">
          <img src="<%= movie.image_url %>" alt="<%= movie.tittel %> poster" class="movie-poster">
          <div class="movie-info">
            <h3><%= movie.tittel %> (<%= movie.årstall %>)</h3>
            <p><i class="fas fa-user-tie"></i> <strong>Regissør:</strong> <%= movie.regissør %></p>
            <p><i class="fas fa-star"></i> <strong>Rating:</strong> <%= movie.rating %> ⭐</p>
            <p><i class="fas fa-tag"></i> <strong>Sjanger:</strong> <%= movie.sjanger %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>