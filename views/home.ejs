<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>

  <title>Heim</title>
</head>

<body>
  <header>
    <nav>
      <ul class="nav">
        <ul><a href="/home" class="active"><i class="fas fa-home"></i> Heim</a></ul>
        <ul><a href="/profile"><i class="fas fa-user"></i> Min profil</a></ul>
        <% if (admin) { %>
          <ul><a href="/admin"><i class="fas fa-cogs"></i> Admin</a></ul>
          <% } %>
            <ul><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logg ut</a></ul>
      </ul>
    </nav>
  </header>

  <div class="page-container">
    <h1 class="page-title">EmreBoxd</h1>

    <!-- Knapp for å legge til film -->
    <a href="/movies/add" id="leggtil">
      <button class="add-movie-button">Legg til film</button>
    </a>

    <div class="movies-container">
      <% movies.forEach(movie=> { %>
        <div class="movie-card">
          <img src="<%= movie.image_url %>" alt="<%= movie.tittel %> poster" class="movie-poster">
          <div class="movie-info">
            <h3>
              <%= movie.tittel %> (<%= movie.årstall %>)
            </h3>
            <p><i class="fas fa-user-tie"></i> <strong>Regissør:</strong>
              <%= movie.regissør %>
            </p>
            <p><i class="fas fa-star"></i> <strong>Rating:</strong>
              <%= movie.rating %> ⭐
            </p>
            <p><i class="fas fa-tag"></i> <strong>Sjanger:</strong>
              <%= movie.sjanger %>
            </p>
          </div>

          <!-- Rediger og slett knapper (admin eller eier) -->
          <% if (admin || movie.user_id===userid) { %>
            <div class="movie-actions">
              <% if (admin) { %>
                <!-- Admin kan redigere eller slette hvilken som helst film -->
                <a href="/admin/edit/<%= movie.id %>"><button class="edit-button">Rediger</button></a>
                <form action="/profile/delete_movie/<%= movie.id %>" method="POST" style="display:inline;"
                  onsubmit="return confirmDelete(event)">
                  <button type="submit" class="delete-button">Slett</button>
                </form>
                <% } else if (movie.user_id===userid) { %>
                  <!-- Vanlig bruker kan kun redigere eller slette sine egne filmer -->
                  <a href="/profile/edit_movie/<%= movie.id %>"><button class="edit-button">Rediger</button></a>
                  <form action="/profile/delete_movie/<%= movie.id %>" method="POST" style="display:inline;"
                    onsubmit="return confirmDelete(event)">
                    <button type="submit" class="delete-button">Slett</button>
                  </form>
                  <% } %>
            </div>
            <% } %>
        </div>
        <% }) %>
    </div>
  </div>

  <script src="/script.js"></script>
</body>

</html>