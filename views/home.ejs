<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>

  <title>Heim</title>
</head>

<body>
  <header>
    <nav>
      <ul class="nav">
        <ul><a href="/home" class="active"><i class="fas fa-home"></i> Heim</a></ul>
        <ul><a href="/profile"><i class="fas fa-user"></i> Min profil</a></ul>
        <% if (admin) { %>
          <ul><a href="/admin"><i class="fas fa-cogs"></i> Admin</a></ul>
        <% } %>
        <ul><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logg ut</a></ul>
      </ul>
    </nav>
  </header>
  
  <div class="page-container">
    <h1 class="page-title">EmreBoxd</h1>
    
    
    
    <div class="movies-container">
      <% movies.forEach(movie => { %>
        <div class="movie-card">
          <img src="<%= movie.image_url %>" alt="<%= movie.tittel %> poster" class="movie-poster">
          <div class="movie-info">
            <h3><%= movie.tittel %> (<%= movie.årstall %>)</h3>
            <p><i class="fas fa-user-tie"></i> <strong>Regissør:</strong> <%= movie.regissør %></p>
            <p><i class="fas fa-star"></i> <strong>Rating:</strong> <%= movie.rating %> ⭐</p>
            <p><i class="fas fa-tag"></i> <strong>Sjanger:</strong> <%= movie.sjanger %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>