<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin.css">
    <script src="script.js"></script>
    <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>
    <title>Admin - EmreBoxd</title>
</head>

<body>
    <header id="admin-header">
        <nav id="admin-nav">
            <ul id="admin-navlinks">
                <li>
                    <a href="/home">
                        <i class="fas fa-home"></i> Heim
                    </a>
                </li>
                <li>
                    <a href="/profile">
                        <i class="fas fa-user"></i> Min profil
                    </a>
                </li>
                <% if (admin) { %>
                <li>
                    <a href="/admin" class="active">
                        <i class="fas fa-cogs"></i> Admin
                    </a>
                </li>
                <% } %>
                <li>
                    <a href="/logout">
                        <i class="fas fa-sign-out-alt"></i> Logg ut
                    </a>
                </li>
            </ul>
        </nav>
    </header>
    

    <main id="admin-main">
        <div id="admin-container" class="container">
            <h2>Rediger Brukar</h2>
            <form action="/admin/edit-user/<%= user.id %>" method="post">

                <label for="firstname">Fornamn:</label>
                <input type="text" name="firstname" id="firstname" value="<%= user.firstname %>" required>

                <label for="lastname">Etternamn:</label>
                <input type="text" name="lastname" id="lastname" value="<%= user.lastname %>" required>

                <label for="email">E-post:</label>
                <input type="email" name="email" id="email" value="<%= user.email %>" required>

                <button type="submit" class="save-btn">Lagre Endringar</button>
                <button type="button" class="cancel-btn" onclick="window.history.back()">Avbryt</button>
            </form>
        </div>
    </main>
</body>

</html>
